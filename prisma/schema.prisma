// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliverableStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum ActivityType {
  PROJECT_CREATED
  CLIENT_INVITED
  DELIVERABLE_CREATED
  DELIVERABLE_SUBMITTED
  DELIVERABLE_VERSION_UPLOADED
  CHANGES_REQUESTED
  DELIVERABLE_APPROVED
  COMMENT_ADDED
  REQUEST_CREATED
  REQUEST_STATUS_CHANGED
  INVOICE_CREATED
  INVOICE_SENT
  INVOICE_PAID
  PROJECT_STATUS_CHANGED
  PROJECT_PROGRESS_UPDATED
}

// ──────────────────────────────────────────────
// Core Identity & Tenancy
// ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A freelancer owns one workspace for MVP simplicity.
  // Easy to evolve to multi-workspace later if needed.
  workspace Workspace?

  // Comments made by this user (freelancer side)
  comments Comment[] @relation("CommentAuthor")

  @@map("users")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String   // e.g. "Sarah's Studio" or just the user's name
  ownerId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clients      Client[]
  projects     Project[]
  subscription Subscription?

  @@map("workspaces")
}

// ──────────────────────────────────────────────
// Clients
// ──────────────────────────────────────────────

model Client {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String
  company     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]

  // Unique email per workspace (same person can be client of different freelancers)
  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("clients")
}

// ──────────────────────────────────────────────
// Projects
// ──────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  clientId    String
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  progress    Int           @default(0) // 0-100, manually set for MVP
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  deliverables Deliverable[]
  requests    Request[]
  invoices    Invoice[]
  activities  Activity[]
  invitations ClientInvitation[]
  access      ProjectAccess[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
  @@map("projects")
}

// ──────────────────────────────────────────────
// Client Access / Invitation (magic-link style)
// ──────────────────────────────────────────────

model ClientInvitation {
  id          String    @id @default(cuid())
  projectId   String
  email       String    // should match the Client.email in most cases
  token       String    @unique // long random token for the invite link
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([projectId])
  @@map("client_invitations")
}

// After the client verifies via OTP / token, we grant access.
// This lets a client have access to multiple projects over time.
model ProjectAccess {
  id        String   @id @default(cuid())
  projectId String
  email     String   // the verified client email
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([email])
  @@map("project_access")
}

// Simple client session for the portal (no password).
// You can also use a short-lived JWT; this table supports server-side sessions if preferred.
model ClientSession {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("client_sessions")
}

// ──────────────────────────────────────────────
// Deliverables + Versions
// ──────────────────────────────────────────────

model Deliverable {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      DeliverableStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions DeliverableVersion[]
  comments Comment[]

  @@index([projectId])
  @@index([status])
  @@map("deliverables")
}

model DeliverableVersion {
  id            String   @id @default(cuid())
  deliverableId String
  versionNumber Int
  fileId        String?  // reference to File
  notes         String?  // optional internal note from freelancer
  createdAt     DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  file        File?       @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([deliverableId, versionNumber])
  @@index([deliverableId])
  @@map("deliverable_versions")
}

// ──────────────────────────────────────────────
// Requests (client-initiated work items)
// ──────────────────────────────────────────────

model Request {
  id          String        @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([projectId])
  @@index([status])
  @@map("requests")
}

// ──────────────────────────────────────────────
// Comments (polymorphic via optional FKs)
// ──────────────────────────────────────────────

model Comment {
  id            String   @id @default(cuid())
  content       String
  // Author can be either a User (freelancer) or a client email
  authorUserId  String?
  authorEmail   String?  // for client comments
  authorName    String?  // denormalized for display
  deliverableId String?
  requestId     String?
  createdAt     DateTime @default(now())

  authorUser  User?        @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  request     Request?     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // Exactly one of deliverableId or requestId should be set (enforced in application)
  @@index([deliverableId])
  @@index([requestId])
  @@index([authorUserId])
  @@map("comments")
}

// ──────────────────────────────────────────────
// Activity / Timeline
// ──────────────────────────────────────────────

model Activity {
  id          String       @id @default(cuid())
  projectId   String
  type        ActivityType
  // Optional structured payload for extra context (version number, comment preview, etc.)
  meta        Json?
  // Who triggered it
  actorUserId String?
  actorEmail  String?
  actorName   String?
  createdAt   DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("activities")
}

// ──────────────────────────────────────────────
// Invoices (project-level, not SaaS billing)
// ──────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  projectId     String
  invoiceNumber String
  description   String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  dueDate       DateTime?
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, invoiceNumber])
  @@index([projectId])
  @@index([status])
  @@map("invoices")
}

// ──────────────────────────────────────────────
// Files (simple storage reference)
// ──────────────────────────────────────────────

model File {
  id          String   @id @default(cuid())
  // Storage key / path in S3, R2, local disk, etc.
  key         String
  filename    String
  mimeType    String?
  size        Int?     // bytes
  createdAt   DateTime @default(now())

  versions DeliverableVersion[]

  @@map("files")
}

// ──────────────────────────────────────────────
// SaaS Subscription (freelancer → your product)
// ──────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
