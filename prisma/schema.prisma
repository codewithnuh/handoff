// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliverableStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum SubscriptionPlan {
  FREE
  PRO
}

// Workspace-level team roles. OWNER is implicit (workspace.ownerId).
enum WorkspaceRole {
  ADMIN
  MEMBER
}

// Project-level roles (override workspace defaults, need-to-know scoping):
//   LEAD        — full edit + submit to client
//   CONTRIBUTOR — drafts only; cannot submit to client
//   OBSERVER    — view-only
enum ProjectRole {
  LEAD
  CONTRIBUTOR
  OBSERVER
}

// Kanban task states — deliberately minimal (freelancer-first simplicity)
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// Paddle subscription statuses (Billing API v2):
// https://developer.paddle.com/concepts/subscriptions/status
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  PAUSED
  CANCELLED
}

enum ActivityType {
  PROJECT_CREATED
  CLIENT_INVITED
  DELIVERABLE_CREATED
  DELIVERABLE_SUBMITTED
  DELIVERABLE_VERSION_UPLOADED
  CHANGES_REQUESTED
  DELIVERABLE_APPROVED
  COMMENT_ADDED
  REQUEST_CREATED
  REQUEST_STATUS_CHANGED
  INVOICE_CREATED
  INVOICE_SENT
  INVOICE_PAID
  PROJECT_STATUS_CHANGED
  PROJECT_PROGRESS_UPDATED
}

// ──────────────────────────────────────────────
// Core Identity & Tenancy
// ──────────────────────────────────────────────

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // Track active workspace state
  activeWorkspaceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1-to-many: User owns multiple workspaces
  workspaces Workspace[] @relation("WorkspaceOwner")

  // Self-relation to active workspace
  activeWorkspace Workspace? @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  comments Comment[] @relation("CommentAuthor")
  sessions Session[]
  accounts Account[]

  // Team memberships
  workspaceMemberships WorkspaceMember[]
  projectMemberships   ProjectMember[]
  assignedTasks        Task[] @relation("TaskAssignee")
  // Subscription
  subscription Subscription?
  @@map("users")
}

// ──────────────────────────────────────────────
// Better Auth (authentication) tables
// Password hashes live on Account.password (email/password provider).
// ──────────────────────────────────────────────

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier, expiresAt])
  @@map("verifications")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String // Removed @unique to allow 1-to-many
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User             @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  activeUsers  User[]           @relation("ActiveWorkspace")
  clients      Client[]
  projects     Project[]
  members      WorkspaceMember[]
  teamInvites  TeamInvitation[]

  @@index([ownerId])
  @@map("workspaces")
}

// Team membership for non-owner collaborators (RBAC level 1).
// Owners are NOT rows here — ownership is workspace.ownerId.
model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// Lightweight kanban tasks inside a project (freelancer to-dos).
// `position` keeps an explicit ordering within each status column.
model Task {
  id          String     @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus @default(TODO)
  position    Int        @default(0)
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@map("tasks")
}

// Pending teammate invitations. The invite carries the invitee's initial
// project assignments (need-to-know scoping) as a JSON array of project IDs.
model TeamInvitation {
  id             String   @id @default(cuid())
  workspaceId    String
  email          String
  token          String   @unique // long random token for the set-password link
  invitedByEmail String? // audit trail — survives inviter deletion
  projectIds     Json? // string[] of projects to assign on accept
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("team_invitations")
}

// Project-level access (RBAC level 2, need-to-know scoping).
// A member without a row here cannot see the project at all.
model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(CONTRIBUTOR)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// ──────────────────────────────────────────────
// Clients
// ──────────────────────────────────────────────

model Client {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String
  company     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects  Project[]

  // Unique email per workspace (same person can be client of different freelancers)
  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("clients")
}

// ──────────────────────────────────────────────
// Projects
// ──────────────────────────────────────────────

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  clientId    String
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  progress    Int           @default(0) // 0-100, manually set for MVP
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  deliverables Deliverable[]
  requests     Request[]
  invoices     Invoice[]
  activities   Activity[]
  invitations  ClientInvitation[]
  access       ProjectAccess[]
  members      ProjectMember[]
  tasks        Task[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
  @@map("projects")
}

// ──────────────────────────────────────────────
// Client Access / Invitation (magic-link style)
// ──────────────────────────────────────────────

model ClientInvitation {
  id         String    @id @default(cuid())
  projectId  String
  email      String // should match the Client.email in most cases
  token      String    @unique // long random token for the invite link
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("client_invitations")
}

// After the client verifies via OTP / token, we grant access.
// This lets a client have access to multiple projects over time.
model ProjectAccess {
  id        String   @id @default(cuid())
  projectId String
  email     String // the verified client email
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([email])
  @@map("project_access")
}

// Simple client session for the portal (no password).
// You can also use a short-lived JWT; this table supports server-side sessions if preferred.
model ClientSession {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("client_sessions")
}

// ──────────────────────────────────────────────
// Deliverables + Versions
// ──────────────────────────────────────────────

model Deliverable {
  id          String            @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      DeliverableStatus @default(DRAFT)
  version     Int               @default(1) // optimistic locking — client must send current version
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions   DeliverableVersion[]
  comments   Comment[]
  lineItems  InvoiceLineItem[]

  @@index([projectId])
  @@index([status])
  @@map("deliverables")
}

model DeliverableVersion {
  id            String   @id @default(cuid())
  deliverableId String
  versionNumber Int
  fileId        String? // reference to File
  notes         String? // optional internal note from freelancer
  createdAt     DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  file        File?       @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([deliverableId, versionNumber])
  @@index([deliverableId])
  @@map("deliverable_versions")
}

// ──────────────────────────────────────────────
// Requests (client-initiated work items)
// ──────────────────────────────────────────────

model Request {
  id          String        @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([projectId])
  @@index([status])
  @@map("requests")
}

// ──────────────────────────────────────────────
// Comments (polymorphic via optional FKs)
// ──────────────────────────────────────────────

model Comment {
  id            String   @id @default(cuid())
  content       String
  // Author can be either a User (freelancer) or a client email
  authorUserId  String?
  authorEmail   String? // for client comments
  authorName    String? // denormalized for display
  deliverableId String?
  requestId     String?
  createdAt     DateTime @default(now())

  authorUser  User?        @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  request     Request?     @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // Exactly one of deliverableId or requestId should be set (enforced in application)
  @@index([deliverableId])
  @@index([requestId])
  @@index([authorUserId])
  @@map("comments")
}

// ──────────────────────────────────────────────
// Activity / Timeline
// ──────────────────────────────────────────────

model Activity {
  id          String       @id @default(cuid())
  projectId   String
  type        ActivityType
  // Optional structured payload for extra context (version number, comment preview, etc.)
  meta        Json?
  // Who triggered it
  actorUserId String?
  actorEmail  String?
  actorName   String?
  createdAt   DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("activities")
}

// ──────────────────────────────────────────────
// Invoices (project-level, not SaaS billing)
// ──────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  projectId     String
  invoiceNumber String
  description   String?
  subtotal      Decimal       @db.Decimal(12, 2) @default(0)
  discount      Decimal       @db.Decimal(12, 2) @default(0)
  taxRate       Decimal       @db.Decimal(5, 2) @default(0)
  taxAmount     Decimal       @db.Decimal(12, 2) @default(0)
  amount        Decimal       @db.Decimal(12, 2) @default(0)
  currency      String        @default("USD")
  dueDate       DateTime?
  paidAt        DateTime?
  paymentNotes  String?
  // Sender (freelancer) details — snapshot at time of creation
  senderName    String?
  senderEmail   String?
  senderAddress Json?
  senderTaxId   String?
  // Client details — snapshot at time of creation
  clientName    String?
  clientEmail   String?
  clientAddress Json?
  clientTaxId   String?
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lineItems InvoiceLineItem[]

  @@unique([projectId, invoiceNumber])
  @@index([projectId])
  @@index([status])
  @@index([status, dueDate])
  @@map("invoices")
}

// ──────────────────────────────────────────────
// Invoice Line Items
// ──────────────────────────────────────────────

model InvoiceLineItem {
  id            String  @id @default(cuid())
  invoiceId     String
  description   String
  quantity      Int     @default(1)
  unitPrice     Decimal @db.Decimal(12, 2)
  amount        Decimal @db.Decimal(12, 2)
  deliverableId String?

  invoice    Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([deliverableId])
  @@map("invoice_line_items")
}

// ──────────────────────────────────────────────
// Files (simple storage reference)
// ──────────────────────────────────────────────

model File {
  id        String   @id @default(cuid())
  // Storage key / path in S3, R2, local disk, etc.
  key       String
  filename  String
  mimeType  String?
  size      Int? // bytes
  createdAt DateTime @default(now())

  versions DeliverableVersion[]

  @@map("files")
}

// ──────────────────────────────────────────────
// SaaS Subscription (freelancer → your product)
// Billed via Paddle (Billing API v2)
// ──────────────────────────────────────────────

model Subscription {
  id          String             @id @default(cuid())
  userId String             @unique
  plan        SubscriptionPlan   @default(FREE)
  status      SubscriptionStatus @default(ACTIVE)

  // Paddle identifiers — https://developer.paddle.com/concepts/overview
  paddleCustomerId     String? @unique // ctm_... — one per workspace owner
  paddleSubscriptionId String? @unique // sub_...
  paddlePriceId        String? // pri_... — identifies which plan/interval they're on

  // Paddle's billing-cycle field is "next_billed_at", not "current_period_end"
  nextBilledAt       DateTime?
  canceledAt         DateTime? // set when Paddle reports subscription.canceled
  pausedAt           DateTime? // set when Paddle reports subscription.paused
  gracePeriodEndsAt  DateTime? // when set, workspace is in grace period after downgrade/cancellation. Read-only after this date.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ──────────────────────────────────────────────
// Paddle webhook idempotency
// Paddle can and will redeliver the same event — always check
// this table before processing, insert before (or in the same
// transaction as) applying side effects.
// https://developer.paddle.com/webhooks/overview
// ──────────────────────────────────────────────

model PaddleWebhookEvent {
  id            String   @id @default(cuid())
  paddleEventId String   @unique // event_id from the webhook payload
  eventType     String // e.g. "subscription.updated", "transaction.paid"
  payload       Json // raw payload, kept for debugging/replay
  processedAt   DateTime @default(now())

  @@index([eventType])
  @@map("paddle_webhook_events")
}
