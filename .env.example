# PostgreSQL connection string used by the running application.
DATABASE_URL="postgresql://user:password@localhost:5432/handoff_dev"

# Required only for local schema push, migration dev/reset, and db:wipe.
# Must target local PostgreSQL database handoff_dev or handoff_test.
# These commands never fall back to DATABASE_URL.
DEV_DATABASE_URL="postgresql://user:password@localhost:5432/handoff_dev"

# Better Auth — use openssl rand -base64 32 (or a 32+ char secret)
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Portal cookie signing — generate independently with: openssl rand -hex 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email via Resend (API) — the recommended transport.
# Sign up at https://resend.com, create an API key at https://resend.com/api-keys,
# and verify a sending domain (or use the default onboarding domain for testing).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Handoff <onboarding@resend.dev>"

# Optional SMTP fallback, used only when RESEND_API_KEY is unset
# (e.g. the local E2E capture harness). Leave empty for normal local work.
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""

# UploadThing v7 server token — get it from https://uploadthing.com/dashboard.
# Required in production and when using uploads; leave empty for local work without uploads.
UPLOADTHING_TOKEN=""
