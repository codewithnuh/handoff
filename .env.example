# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/handoff"

# Better Auth — use openssl rand -base64 32 (or a 32+ char secret)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Legacy auth secret (kept for compatibility)
AUTH_SECRET="replace-with-a-random-secret"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Outbound email via SMTP (nodemailer). Required in production.
# Works with Gmail (smtp.gmail.com:465 + app password), Resend SMTP, Postmark, SES, etc.
# When unset in development, emails are logged to the console instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Handoff <no-reply@yourdomain.com>"
