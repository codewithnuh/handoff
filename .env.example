# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/handoff"

# Better Auth — use openssl rand -base64 32 (or a 32+ char secret)
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Portal cookie signing — generate independently with: openssl rand -hex 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Outbound email via SMTP (nodemailer). Required in production; optional in development.
# Works with Gmail (smtp.gmail.com:465 + app password), Resend SMTP, Postmark, SES, etc.
# When unset in development, emails are logged to the console instead of sent.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# UploadThing v7 server token — get it from https://uploadthing.com/dashboard.
# Required in production and when using uploads; leave empty for local work without uploads.
UPLOADTHING_TOKEN=""
